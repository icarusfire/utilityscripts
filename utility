# CI only when the whitelist file changes on master
trigger:
  branches:
    include:
      - master
  paths:
    include:
      - /myrepo/module1/pipelines/whitelist.yaml

pr: none

pool:
  vmImage: 'ubuntu-latest'

variables:
  # Path to the file we sync
  WHITELIST_PATH: '/myrepo/module1/pipelines/whitelist.yaml'

jobs:
- job: SyncWhitelistToRelease
  steps:
    # Ensure the job token is available to scripts and Git client
    - checkout: self
      persistCredentials: true  # leaves the OAuth token for scripts/clients to use (required). :contentReference[oaicite:1]{index=1}

    # Dummy step that will later compute the train dynamically
    - bash: |
        echo "##vso[task.setvariable variable=releaseTrainBranch]5.123"
      displayName: "Compute releaseTrainBranch (dummy now)"

    # Run the Python sync script
    - task: UsePythonVersion@0
      inputs:
        versionSpec: '3.x'

    - script: |
        python3 scripts/sync_whitelist_to_release.py \
          --source-branch "refs/heads/master" \
          --target-branch "refs/heads/releasetrain/trains/$(releaseTrainBranch)" \
          --file-path "$(WHITELIST_PATH)"
      displayName: "Sync whitelist.yaml to release train via PR"
      env:
        # Exposes the job access token to the script. In scripts it’s env var SYSTEM_ACCESSTOKEN. :contentReference[oaicite:2]{index=2}
        SYSTEM_ACCESSTOKEN: $(System.AccessToken)


