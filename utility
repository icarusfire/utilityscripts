# Trigger: only when whitelist.yaml changes on master (minimize runs).
trigger:
  branches:
    include:
      - master
  paths:
    include:
      - myrepo/module1/pipelines/whitelist.yaml

pr: none

variables:
  # Repo-relative path to watch (normalized with leading slash in API).
  WATCH_PATH: /myrepo/module1/pipelines/whitelist.yaml
  # Name prefix for the temporary branch created by cherry-pick:
  CHERRY_BRANCH_PREFIX: refs/heads/cherry/whitelist
  SYSTEM_DEBUG: false

pool:
  vmImage: 'ubuntu-latest'

stages:
- stage: cherry_pick_whitelist
  displayName: 'Cherry-pick whitelist.yaml to release train'
  jobs:
  - job: run_logic
    displayName: 'Verify change & create PR'
    steps:
    - checkout: self
      persistCredentials: true   # enables $(System.AccessToken) for REST calls

    # Dummy step for now: sets releaseTrainBranch to "5.123"
    - task: UsePythonVersion@0
      displayName: 'Use Python 3.x'
      inputs:
        versionSpec: '3.x'

    - script: |
        python3 scripts/set_release_train.py
      displayName: 'Set releaseTrainBranch (dummy for now)'
      name: setrt

    # Detect whether the original PR changed ONLY the whitelist file
    - script: |
        python3 scripts/detect_whitelist_only_change.py \
          --watch-path "$(WATCH_PATH)"
      displayName: 'Detect if ONLY whitelist.yaml changed in the original PR'
      name: detect

    # If detection says proceed, do cherry-pick + PR creation
    - script: |
        python3 scripts/cherry_pick_and_create_pr.py \
          --release-train "$(releaseTrainBranch)"
      displayName: 'Cherry-pick PR onto release train and open PR'
      condition: and(succeeded(), eq(variables['shouldCherryPick'], 'true'))
      name: cherry

    # Always print out what happened (including link if created)
    - script: |
        echo "Decision: shouldCherryPick=$(shouldCherryPick)"
        echo "Original PR Id (if found): $(sourcePrId)"
        echo "Changed files (count): $(changedFileCount)"
        echo "Changed file (if single): $(changedFilePath)"
        echo "Cherry-pick branch: $(cherryBranchName)"
        echo "Created PR URL (if any): $(createdPrUrl)"
      displayName: 'Summary'



