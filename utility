#!/usr/bin/env python3
import argparse, os, sys, time, json
import requests

def ado():
    return {
        "org_url": os.environ["SYSTEM_TEAMFOUNDATIONCOLLECTIONURI"].rstrip("/"),
        "project": os.environ["SYSTEM_TEAMPROJECT"],
        "repo_id": os.environ["BUILD_REPOSITORY_ID"],
        "commit": os.environ["BUILD_SOURCEVERSION"],
        "token": os.environ.get("SYSTEM_ACCESSTOKEN", "")
    }

def api(url):
    return f"{url}?api-version=7.1"

def auth_headers(token):
    if not token:
        print("SYSTEM_ACCESSTOKEN is not available. Enable 'Allow scripts to access OAuth token' or set persistCredentials: true.", file=sys.stderr)
        sys.exit(1)
    return {
        "Authorization": f"Bearer {token}",
        "Content-Type": "application/json"
    }

def set_var(name, value):
    print(f"##vso[task.setvariable variable={name}]{value}")

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--watch-path", required=True, help="Repo-absolute path beginning with /")
    args = parser.parse_args()

    cfg = ado()
    headers = auth_headers(cfg["token"])
    base = f"{cfg['org_url']}/{cfg['project']}/_apis/git/repositories/{cfg['repo_id']}"

    # 1) Pull Request Query – map commit -> PR(s)
    q_url = api(f"{cfg['org_url']}/{cfg['project']}/_apis/git/pullrequestquery")
    body = {"queries": [{"items": [{"commitId": cfg["commit"]}]}]}
    resp = requests.post(q_url, headers=headers, data=json.dumps(body))
    resp.raise_for_status()
    data = resp.json()

    pr_id = None
    try:
        # The structure is queries[0].results[commitId] = [prs...]
        results = data["results"][0]["result"]
        # keys are commitIds; pick our commit id key (case-insensitive)
        pr_list = None
        for k, v in results.items():
            if k.lower() == cfg["commit"].lower():
                pr_list = v
                break
        if pr_list:
            # Prefer the completed PR that produced the merge into master
            # If multiple, pick the most recent by completion time.
            pr_list_sorted = sorted(pr_list, key=lambda x: x.get("closedDate", ""), reverse=True)
            pr_id = pr_list_sorted[0]["pullRequestId"] if pr_list_sorted else None
    except Exception:
        pass

    if not pr_id:
        # No PR—skip cherry-pick.
        set_var("shouldCherryPick", "false")
        set_var("sourcePrId", "")
        set_var("changedFileCount", "0")
        set_var("changedFilePath", "")
        print("No originating PR found for this commit. Skipping.")
        return

    set_var("sourcePrId", str(pr_id))

    # 2) Get latest iteration id
    iters_url = api(f"{base}/pullRequests/{pr_id}/iterations")
    iters = requests.get(iters_url, headers=headers).json()
    if "value" not in iters or not iters["value"]:
        set_var("shouldCherryPick", "false")
        set_var("changedFileCount", "0")
        set_var("changedFilePath", "")
        print("PR has no iterations. Skipping.")
        return

    latest_iter_id = max(i["id"] for i in iters["value"])
    # 3) Get the cumulative changes for the latest iteration (vs merge base)
    chg_url = api(f"{base}/pullRequests/{pr_id}/iterations/{latest_iter_id}/changes")
    changes = requests.get(chg_url, headers=headers).json()

    paths = []
    for ch in changes.get("changes", []):
        item = ch.get("item")
        if isinstance(item, dict):
            p = item.get("path")
            if p:
                paths.append(p)

    unique_paths = sorted(set(paths))
    set_var("changedFileCount", str(len(unique_paths)))
    if len(unique_paths) == 1:
        set_var("changedFilePath", unique_paths[0])
    else:
        set_var("changedFilePath", "")

    # 4) Enforce rule: exactly one file and it equals WATCH_PATH
    if len(unique_paths) == 1 and unique_paths[0] == args.watch_path:
        set_var("shouldCherryPick", "true")
        print(f"Whitelist-only change verified: {unique_paths[0]}")
    else:
        set_var("shouldCherryPick", "false")
        print(f"Skip: changed files = {unique_paths}")

if __name__ == "__main__":
    main()



