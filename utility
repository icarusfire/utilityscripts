#!/usr/bin/env python3
"""
Sync a single file from a given source branch (default: master) into a PR targeting a release-train branch.

- Reads the file content via Azure DevOps Items REST API from the specified source branch.
- Creates a short-lived work branch FROM the target release-train branch (so the PR diff is only that file).
- Updates the file on the work branch and opens a PR into the target branch.
- Prints the PR URL.

Requirements:
- Your existing AzureGitConnector utility (imported below).
- Python packages: requests (this script) and azure-devops (used by your connector).
"""

import os
import sys
import argparse
import datetime
import requests
from urllib.parse import quote

# Reuse your existing connector. Ensure this import path matches where your utility lives.
# For example, if your shared utility is at repo root: /your_module/azure_git_connector.py,
# add that folder to PYTHONPATH or adjust the import accordingly.
from azure_git_connector import AzureGitConnector  # <-- adjust if your module path differs


def _auth_header(pat: str) -> dict:
    """
    Use System.AccessToken as a PAT via Basic Auth (username can be blank).
    """
    import base64
    token = base64.b64encode(f":{pat}".encode("utf-8")).decode("utf-8")
    return {"Authorization": f"Basic {token}"}


def fetch_file_from_branch_rest(git: AzureGitConnector, file_path: str, branch_name: str) -> bytes:
    """
    Read a file's content from a specific branch using the Azure DevOps Items REST API.
    Returns UTF-8 bytes.
    """
    org = git.organization_url.rstrip("/")           # e.g., https://dev.azure.com/ORG
    proj = git.project_name
    repo_id = git.repository_id

    encoded_path = quote(file_path, safe="/")
    url = (
        f"{org}/{proj}/_apis/git/repositories/{repo_id}/items"
        f"?path={encoded_path}"
        f"&versionType=branch&version={quote(branch_name)}"
        f"&includeContent=true&resolveLfs=true"
        f"&api-version=7.1-preview.1"
    )

    headers = _auth_header(git.access_token)
    r = requests.get(url, headers=headers)
    if r.status_code != 200:
        print(f"[ERROR] Failed to fetch {file_path} from branch '{branch_name}': "
              f"{r.status_code} {r.text}", file=sys.stderr)
        sys.exit(1)

    data = r.json()
    content = data.get("content", "")
    return content.encode("utf-8")


def main():
    parser = argparse.ArgumentParser(description="Sync a single file into a PR targeting a release-train branch.")
    parser.add_argument("--source-file-branch", required=True,
                        help="Branch name to read the file from (e.g., 'master'). Not a full ref.")
    parser.add_argument("--target-branch", required=True,
                        help="Full ref for the train branch (e.g., 'refs/heads/releasetrain/trains/5.123').")
    parser.add_argument("--file-path", required=True,
                        help="Repository path to the file, starting with '/'.")
    args = parser.parse_args()

    token = os.environ.get("SYSTEM_ACCESSTOKEN")
    if not token:
        print("[ERROR] SYSTEM_ACCESSTOKEN is not available to the script.", file=sys.stderr)
        sys.exit(1)

    git = AzureGitConnector(token)

    # 1) Fetch the source file bytes from the specified branch (default you pass is 'master').
    source_bytes = fetch_file_from_branch_rest(git, args.file_path, args.source_file_branch)

    # 2) Create a short-lived working branch FROM the target branch.
    ts = datetime.datetime.utcnow().strftime("%Y%m%d%H%M%S")
    work_branch = f"auto/sync-whitelist-{ts}"
    git.set_branch(work_branch, source_branch_name=args.target_branch)

    # 3) Update the file content on the work branch.
    git.update_file_in_branch(work_branch, args.file_path, source_bytes)

    # 4) Open a PR from work_branch -> target branch and print its URL.
    pr_title = f"[SYNC] {args.file_path} from {args.source_file_branch} to {args.target_branch}"
    pr_desc = (
        f"Automated sync of {args.file_path}\n\n"
        f"Source branch: {args.source_file_branch}\n"
        f"Target: {args.target_branch}\n"
        f"Time (UTC): {datetime.datetime.utcnow().isoformat()}Z"
    )

    pr_url = git.create_git_request(
        source_branch_name=work_branch,
        target_branch_name=args.target_branch,
        title=pr_title,
        description=pr_desc
    )

    print(pr_url)


if __name__ == "__main__":
    main()


