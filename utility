#!/usr/bin/env python3
import argparse, os, sys, time, json, re
import requests
from datetime import datetime

POLL_SECS = 2
POLL_MAX = 120  # ~4 minutes

def ado():
    return {
        "org_url": os.environ["SYSTEM_TEAMFOUNDATIONCOLLECTIONURI"].rstrip("/"),
        "project": os.environ["SYSTEM_TEAMPROJECT"],
        "repo_id": os.environ["BUILD_REPOSITORY_ID"],
        "commit": os.environ["BUILD_SOURCEVERSION"],
        "token": os.environ.get("SYSTEM_ACCESSTOKEN", ""),
        "source_pr_id": os.environ.get("sourcePrId", ""),
    }

def api(url):
    return f"{url}?api-version=7.1"

def auth_headers(token):
    if not token:
        print("SYSTEM_ACCESSTOKEN is not available.", file=sys.stderr)
        sys.exit(1)
    return {
        "Authorization": f"Bearer {token}",
        "Content-Type": "application/json"
    }

def set_var(name, value):
    print(f"##vso[task.setvariable variable={name}]{value}")

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--release-train", required=True, help="e.g. 5.123")
    args = parser.parse_args()

    cfg = ado()
    headers = auth_headers(cfg["token"])
    base = f"{cfg['org_url']}/{cfg['project']}/_apis/git/repositories/{cfg['repo_id']}"

    if not cfg["source_pr_id"]:
        set_var("createdPrUrl", "")
        print("No source PR id found. Nothing to do.")
        return

    # Build ref names
    onto_ref = f"refs/heads/releasetrain/trains/{args.release_train}"

    # Sanitize a short suffix for generated branch (commit short + timestamp)
    commit_short = cfg["commit"][:8]
    ts = datetime.utcnow().strftime("%Y%m%d%H%M%S")
    cherry_branch = f"refs/heads/cherry/whitelist-{commit_short}-to-{args.release_train}-{ts}"
    set_var("cherryBranchName", cherry_branch)

    # 1) Cherry-pick the PR into a new branch based on the release train
    body = {
      "generatedRefName": cherry_branch,
      "ontoRefName": onto_ref,
      "repository": {"id": cfg["repo_id"]},
      "source": {
        "pullRequestId": int(cfg["source_pr_id"])
      }
    }

    cp_url = api(f"{base}/cherryPicks")
    resp = requests.post(cp_url, headers=headers, data=json.dumps(body))
    resp.raise_for_status()
    cp = resp.json()
    cp_id = cp.get("cherryPickId")
    if not cp_id:
        print("Unexpected response from cherry-picks API:", cp, file=sys.stderr)
        sys.exit(2)

    # 2) Poll until completed/failed
    get_cp_url = api(f"{base}/cherryPicks/{cp_id}")
    status = None
    detail = None
    for _ in range(POLL_MAX):
        s = requests.get(get_cp_url, headers=headers).json()
        status = s.get("status")
        detail = s.get("detailedStatus", {})
        if status in ("completed", "failed", "abandoned"):
            break
        time.sleep(POLL_SECS)

    if status != "completed":
        # Surface conflict/failure message for observability
        msg = (detail or {}).get("failureMessage", "Cherry-pick did not complete.")
        print(f"Cherry-pick status: {status}. Detail: {msg}")
        set_var("createdPrUrl", "")
        # Leave non-zero to surface in pipeline if you prefer:
        sys.exit(3)

    # 3) Open a PR from cherry branch -> onto_ref
    pr_title = f"Cherry-pick whitelist.yaml from PR #{cfg['source_pr_id']} to {args.release_train}"
    pr_body = {
      "sourceRefName": cherry_branch,
      "targetRefName": onto_ref,
      "title": pr_title,
      "description": (
        f"Automated cherry-pick of PR #{cfg['source_pr_id']} "
        f"({commit_short}) onto `{args.release_train}`.\n\n"
        f"Scope: myrepo/module1/pipelines/whitelist.yaml only."
      ),
      "isDraft": False
    }
    pr_url = api(f"{base}/pullrequests")
    pr_resp = requests.post(pr_url, headers=headers, data=json.dumps(pr_body))
    pr_resp.raise_for_status()
    pr = pr_resp.json()
    web_url = pr.get("url")  # REST URL; try to build the friendly one too:
    # Construct a friendly link if possible:
    org_host = cfg["org_url"].replace("https://", "").rstrip("/")
    friendly = (
        f"{cfg['org_url']}/{cfg['project']}/_git/{os.environ.get('BUILD_REPOSITORY_NAME','')}"
        f"/pullrequest/{pr.get('pullRequestId')}"
    )

    set_var("createdPrUrl", friendly)
    print("Created PR:", friendly)

if __name__ == "__main__":
    main()


