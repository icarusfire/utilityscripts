- script: |
    python get_release_notes.py "$(target_num)"
  name: pickNotes
  displayName: Pick target release notes



import os
import pathlib
import sys

def get_release_notes(target_num, max_runs=5):
    ws = os.getenv('PIPELINE_WORKSPACE', '.')
    release_root = pathlib.Path(ws) / 'ReleaseNotes'

    # newest first
    run_dirs = sorted(
        (d for d in release_root.iterdir() if d.is_dir()),
        key=lambda d: d.stat().st_mtime,
        reverse=True)[:max_runs]

    for run_dir in run_dirs:  # newest → oldest among last max_runs
        root = run_dir / 'ReleaseNotesKansCHG'
        if not root.is_dir():
            continue

        for rel_dir in root.iterdir():
            if not rel_dir.is_dir():
                continue

            try:
                rel_num = rel_dir.name.split('_')[0]
                if rel_num != target_num:
                    continue

                notes_path = root / 'RELEASE_NOTES.md'
                all_path = rel_dir / f'{rel_num}_all.txt'

                notes = notes_path.read_text(encoding='utf-8')
                all_txt = all_path.read_text(encoding='utf-8')
            except Exception as exc:
                # log + skip this rel_dir; continue searching
                print(f'Skipping run {run_dir.name} ({rel_dir.name}): {exc}')
                continue

            combined = notes + '\n\n' + all_txt
            description = (combined
                .replace('%', '%25')
                .replace('\r', '%0D')
                .replace('\n', '%0A'))
            return rel_num, description

    raise ValueError(f'No matching release num {target_num} found in last {max_runs} runs.')

# CLI wrapper so pipeline step can capture variables
if __name__ == '__main__':
    if len(sys.argv) != 2:
        sys.exit('usage: python get_release_notes.py <target_num>')
    rel, desc = get_release_notes(sys.argv[1])
    print(f'##vso[task.setvariable variable=rel_num;isOutput=true]{rel}')
    print(f'##vso[task.setvariable variable=description;isOutput=true]{desc}')
