#!/usr/bin/env python3
import os
import sys
import argparse
import base64
import datetime

# Reuse your existing connector
from your_module.azure_git_connector import AzureGitConnector  # adjust import path to your utility

# Azure DevOps Python client models (installed via `pip install azure-devops`)
from azure.devops.v7_1.git.models import GitVersionDescriptor, GitVersionType  # :contentReference[oaicite:7]{index=7}

def read_file_from_branch(connector: AzureGitConnector, path: str, branch_ref: str) -> bytes:
    """
    Return file bytes from a specific branch ref.
    """
    vd = GitVersionDescriptor(version=branch_ref, version_type=GitVersionType.branch)
    item = connector.git_client.get_item(
        repository_id=connector.repository_id,
        path=path,
        project=connector.project_name,
        version_descriptor=vd,
        include_content=True
    )  # Items - Get supports version descriptor + includeContent. :contentReference[oaicite:8]{index=8}

    # azure-devops client returns content as string
    content_str = item.content or ""
    return content_str.encode("utf-8")

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--source-branch", required=True, help="Full ref, e.g., refs/heads/master")
    parser.add_argument("--target-branch", required=True, help="Full ref, e.g., refs/heads/releasetrain/trains/5.123")
    parser.add_argument("--file-path", required=True, help="Repository path starting with /")
    args = parser.parse_args()

    token = os.environ.get("SYSTEM_ACCESSTOKEN")
    if not token:
        print("SYSTEM_ACCESSTOKEN is not available to the script.", file=sys.stderr)
        sys.exit(1)

    git = AzureGitConnector(token)

    # 1) Read the master version of the file
    master_bytes = read_file_from_branch(git, args.file_path, args.source_branch.replace("refs/heads/", ""))

    # 2) Create a short-lived working branch FROM the target branch
    ts = datetime.datetime.utcnow().strftime("%Y%m%d%H%M%S")
    work_branch = f"auto/sync-whitelist-{ts}"
    git.set_branch(work_branch, source_branch_name=args.target_branch)

    # 3) Write the master content into that working branch (base64 handled in your helper)
    git.update_file_in_branch(work_branch, args.file_path, master_bytes)

    # 4) Open a PR from the working branch into the target release train branch
    pr_title = f"[SYNC] {args.file_path} from master to {args.target_branch}"
    pr_desc = (
        f"Automated sync of {args.file_path}\n\n"
        f"Source: {args.source_branch}\nTarget: {args.target_branch}\n"
        f"Time (UTC): {datetime.datetime.utcnow().isoformat()}Z"
    )
    pr_url = git.create_git_request(source_branch_name=work_branch,
                                    target_branch_name=args.target_branch,
                                    title=pr_title,
                                    description=pr_desc)  # Uses Git Pull Requests API. :contentReference[oaicite:9]{index=9}

    # 5) Print the final PR URL (visible in pipeline logs)
    print(pr_url)

if __name__ == "__main__":
    main()
