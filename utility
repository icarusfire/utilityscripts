def parse_train_number(train_number: str) -> tuple[str, str]:
    """
    Given '5.123' -> returns ('5.123', '5.122').
    """
    import re
    m = re.fullmatch(r"([^\.]+)\.(\d+)", train_number.strip())
    if not m:
        raise ValueError(f"Invalid train number format: {train_number}. Expected like '5.123'.")
    major, minor_str = m.group(1), m.group(2)
    minor = int(minor_str)
    if minor <= 0:
        raise ValueError(f"Cannot decrement {train_number} because the minor part is <= 0.")
    return f"{major}.{minor}", f"{major}.{minor-1}"


def make_target_ref(train_str: str) -> str:
    return f"refs/heads/releasetrain/trains/{train_str}"


def create_pr_for_target(git, target_ref: str, file_path: str, content: bytes,
                         source_file_branch_name: str) -> str:
    """
    Create a work branch FROM target_ref, write content, open PR back to target_ref.
    Returns PR URL.
    """
    ts = datetime.datetime.utcnow().strftime("%Y%m%d%H%M%S")
    safe_suffix = target_ref.split("/")[-1].replace(".", "-")  # e.g., '5.123' -> '5-123'
    work_branch_short = f"auto/sync-{safe_suffix}-{ts}"

    git.set_branch(work_branch_short, source_branch_name=target_ref)
    git.update_file_in_branch(work_branch_short, file_path, content)

    pr_title = f"[SYNC] {file_path} from {source_file_branch_name} to {target_ref}"
    pr_desc = (
        f"Automated sync of {file_path}\n\n"
        f"Source file branch: {source_file_branch_name}\n"
        f"PR target: {target_ref}\n"
        f"Time (UTC): {datetime.datetime.utcnow().isoformat()}Z"
    )

    return git.create_git_request(
        source_branch_name=work_branch_short,
        target_branch_name=target_ref,
        title=pr_title,
        description=pr_desc
    )




def main():
    parser = argparse.ArgumentParser(
        description="Create two PRs to successive release-train branches from one source file branch."
    )
    parser.add_argument("--train-number", required=True,
                        help="Train number like '5.123'. Will also target the previous '5.122'.")
    parser.add_argument("--source-file-branch", required=True,
                        help="Branch name to read the file from (e.g., 'master'). Not a full ref.")
    parser.add_argument("--file-path", required=True,
                        help="Repository path to the file, starting with '/'.")
    parser.add_argument("--access-token", required=False,
                        help="Access token (e.g., $(System.AccessToken)). If omitted, uses env SYSTEM_ACCESSTOKEN.")
    args = parser.parse_args()

    token = args.access_token or os.environ.get("SYSTEM_ACCESSTOKEN")
    if not token:
        print("[ERROR] No access token provided. Pass --access-token or set SYSTEM_ACCESSTOKEN.", file=sys.stderr)
        sys.exit(1)

    git = AzureGitConnector(token)

    # Compute targets: current train and previous train
    curr_train, prev_train = parse_train_number(args.train_number)
    targets = [make_target_ref(curr_train), make_target_ref(prev_train)]

    # Read source content once from the specified source branch
    source_bytes = fetch_file_from_branch_rest(git, args.file_path, args.source_file_branch, token)

    # Create PRs for both targets
    pr_urls = []
    for target_ref in targets:
        try:
            pr_url = create_pr_for_target(
                git, target_ref, args.file_path, source_bytes, args.source_file_branch
            )
            pr_urls.append(pr_url)
        except Exception as e:
            print(f"[ERROR] Failed creating PR for target {target_ref}: {e}", file=sys.stderr)
            # continue to next target rather than exiting
            continue

    # Print PR URLs (one per line)
    for url in pr_urls:
        print(url)
