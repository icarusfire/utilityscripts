def next_week_targets_for_servicenow(today=None):
    """Return UTC strings that will *display* as 06:00 / 12:00 in NL."""
    if today is None:
        today = datetime.now(ZoneInfo(LOCAL_TZ)).date()

    this_monday = today - timedelta(days=today.weekday())
    next_monday = this_monday + timedelta(days=7)

    th_local = datetime.combine(next_monday + timedelta(days=3),
                                time(6, 0, 0),
                                tzinfo=ZoneInfo(LOCAL_TZ))
    fr_local = datetime.combine(next_monday + timedelta(days=4),
                                time(12, 0, 0),
                                tzinfo=ZoneInfo(LOCAL_TZ))

    th_utc = th_local.astimezone(timezone.utc)
    fr_utc = fr_local.astimezone(timezone.utc)

    fmt = "%m-%d-%Y %H:%M:%S"
    return th_utc.strftime(fmt), fr_utc.strftime(fmt)
